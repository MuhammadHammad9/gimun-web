{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3100",
      "startServerReadyPattern": "Ready",
      "url": ["http://127.0.0.1:3100/", "http://127.0.0.1:3100/register", "http://127.0.0.1:3100/resources"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 1 },
        "throttling": { "rttMs": 150, "throughputKbps": 1600, "requestLatencyMs": 150, "downloadThroughputKbps": 1600, "uploadThroughputKbps": 750, "cpuSlowdownMultiplier": 4 }
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3000 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "non-composited-animations": ["error", { "maxLength": 0 }],
        "errors-in-console": ["error", { "maxLength": 0 }],
        "bf-cache": ["error", { "maxLength": 0 }],
        "heading-order": ["error", { "minScore": 1 }],
        "color-contrast": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./artifacts/lighthouse" }
  }
}
