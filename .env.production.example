# Deployment template only. Copy these names into the hosting provider's
# encrypted environment settings; never commit populated credentials.
NODE_ENV=production
CMS_BACKEND=supabase
SUBMISSIONS_BACKEND=supabase

SITE_URL=https://example.org
NEXT_PUBLIC_SITE_URL=https://example.org

# Browser-safe Supabase values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase values. The URL must match the browser URL above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_FETCH_TIMEOUT_MS=5000

# Email provider configuration.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=

# Distributed rate limiting and scheduled worker authentication.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=
CRON_SECRET=

# Cloudflare Turnstile human check on the public forms. Set both.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Require MFA for every admin account.
ADMIN_REQUIRE_MFA=1

# Optional public analytics identifier. Empty disables analytics.
ANALYTICS_MEASUREMENT_ID=

# These must remain disabled outside isolated automated tests.
ALLOW_IN_MEMORY_SUBMISSIONS=0
SUBMISSIONS_TEST_MODE=0
