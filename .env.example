# ============================================================
# GIMUN & GMC 2027 — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git. Only .env.example is safe to commit.
# In Vercel: add these under Project Settings → Environment Variables.
# ============================================================

# ----------------------------------------------------------
# REQUIRED — Public Site URL
# ----------------------------------------------------------
# Production domain (must match custom domain in Vercel)
# Used by metadata, OG images, sitemap.xml, and robots.txt
SITE_URL=https://gimungiki.org

# ----------------------------------------------------------
# OPTIONAL — Analytics (add after launch once GA4 is set up)
# ----------------------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Leave empty to disable analytics completely
ANALYTICS_MEASUREMENT_ID=

# ----------------------------------------------------------
# REQUIRED for Email Notifications — Resend
# ----------------------------------------------------------
# Get key at: https://resend.com/api-keys
# Create account → Add Domain (gimungiki.org) → Verify DNS → Generate key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address — must match a verified domain in Resend
EMAIL_FROM=GIMUN & GMC Secretariat <no-reply@gimungiki.org>

# All form submissions send a notification copy to this address
NOTIFICATION_EMAIL=info@gimungiki.org

# ----------------------------------------------------------
# REQUIRED in production — Distributed Rate Limiting (Upstash Redis)
# ----------------------------------------------------------
# Prevents form spam bursts. Free tier at https://upstash.com
# Local development may leave these empty and use the test-only memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------
# REQUIRED in production — Database Backend
# ----------------------------------------------------------
# For production: use Supabase to persist submissions across serverless instances
# Get credentials at: Supabase Dashboard → Project Settings → API
# Use the server-only secret key; never expose it to browser code.
# Leave empty for local development (memory is the development default).
# Set to supabase in staging/production.
SUBMISSIONS_BACKEND=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ----------------------------------------------------------
# REQUIRED in production — Submission security
# ----------------------------------------------------------
RATE_LIMIT_HMAC_SECRET=
CRON_SECRET=
