# Copy to .env.local. Never commit real credentials.
# Use Node 24. Provider settings must belong to the same staging/production environment.
SITE_URL=http://localhost:3000
# memory (default outside production) keeps local runs away from real data and email.
# Set supabase only with a dedicated dev/staging project filled in below.
SUBMISSIONS_BACKEND=memory
# bundled avoids remote CMS reads for local/offline development. Use supabase
# (or leave unset) when a reachable, migrated provider project is configured.
CMS_BACKEND=bundled

# Supabase browser credentials (publishable key ONLY; never a service-role key).
# Read at build time (next.config.ts, admin media upload): set them before `next build`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only database credentials. URL must match NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Existing deployments may use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
# Optional provider request timeout in milliseconds (minimum 1000; default 5000).
SUPABASE_FETCH_TIMEOUT_MS=5000

# Verified Resend sender, provider API key, and organizer notification recipients.
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=

# Distributed abuse protection. Generate independent random secrets outside this file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_HMAC_SECRET=
CRON_SECRET=
# Optional: overrides every per-purpose rate limit (tests only; defaults live in src/lib/honeypot.ts).
RATE_LIMIT_MAX=
# Set to 1 to require two-factor sign-in for every admin account.
ADMIN_REQUIRE_MFA=

# Optional analytics. Empty disables it.
ANALYTICS_MEASUREMENT_ID=
# Compatibility aliases: NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_GA_ID.

# Automated tests only. Production memory mode also requires a loopback SITE_URL.
ALLOW_IN_MEMORY_SUBMISSIONS=0
SUBMISSIONS_TEST_MODE=0
# First-owner provisioning uses temporary shell variables, not checked-in values:
# ADMIN_OWNER_EMAIL, ADMIN_OWNER_TEMP_PASSWORD (12+ characters)
