{
  "name": "gimun-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "validate:launch": "node scripts/validate-launch.mjs",
    "test:emergency": "npm run test:admin",
    "audit:links": "node scripts/audit-links.js",
    "audit:a11y": "node scripts/audit-accessibility.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:submissions": "node scripts/audit-submissions.mjs",
    "test:forms": "node scripts/test-forms-e2e.js",
    "test:browser": "node scripts/run-browser-tests.cjs",
    "audit:lighthouse": "lhci autorun --config=lighthouserc.json",
    "git:graph": "git log --graph --all --pretty=format:\"%C(bold yellow)%h%Creset -%C(auto)%d%Creset %C(white)%s%Creset %C(dim white)(%cr)%Creset %C(bold blue)<%an>%Creset\" -n 20",
    "git:tree": "git log --graph --all --oneline --decorate",
    "qa:full": "npm run validate && npm run test:unit && npm run test:migrations && npm run typecheck && npm run lint && npm run build && npm run audit:links && npm run audit:a11y && npm run audit:seo && npm run audit:submissions && npm run test:forms && npm run test:browser && npm run test:admin",
    "qa:launch": "npm run validate:launch && npm run qa:full",
    "test:unit": "vitest run",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:admin": "node scripts/test-admin-e2e.mjs",
    "content:seed": "tsx scripts/seed-content.ts",
    "content:export": "node scripts/export-content.mjs",
    "admin:owner": "node scripts/provision-owner.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
