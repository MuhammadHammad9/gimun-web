{
  "name": "gimun-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "validate:launch": "node scripts/validate-launch.mjs",
    "test:emergency": "npm run test:admin",
    "audit:links": "node scripts/audit-links.js",
    "audit:a11y": "node scripts/audit-accessibility.js",
    "audit:seo": "node scripts/audit-seo.js",
    "audit:submissions": "node scripts/audit-submissions.mjs",
    "test:forms": "node scripts/test-forms-e2e.js",
    "test:browser": "node scripts/run-browser-tests.cjs",
    "audit:lighthouse": "lhci autorun --config=lighthouserc.json",
    "audit:bundle": "node scripts/report-first-load.js",
    "git:graph": "git log --graph --decorate=short --date=relative --pretty=format:\"%C(bold yellow)%h%Creset %C(auto)%d%Creset %C(white)%s%Creset %C(dim cyan)(%cr)%Creset %C(bold blue)<%an>%Creset\" -n 35",
    "git:tree": "node scripts/git-tree.mjs",
    "qa:full": "npm run scan:secrets && npm run validate && npm run test:unit && npm run test:migrations && npm run typecheck && npm run lint && npm run build && npm run audit:bundle && npm run audit:links && npm run audit:a11y && npm run audit:seo && npm run audit:submissions && npm run test:forms && npm run test:browser && npm run test:admin",
    "qa:launch": "npm run validate:launch && npm run qa:full",
    "test:unit": "vitest run",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:admin": "node scripts/test-admin-e2e.mjs",
    "content:seed": "tsx scripts/seed-content.ts",
    "content:export": "node scripts/export-content.mjs",
    "admin:owner": "node scripts/provision-owner.mjs",
    "check:env": "node scripts/check-env.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/browser": "^0.2.1",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.50.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "ogl": "1.0.11",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
