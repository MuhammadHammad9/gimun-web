# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env
!.env.example

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# vercel
.vercel

# supabase CLI local state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# local runtime data submissions
data/submissions/*.json
!data/submissions/.gitkeep

# test results
test-results/
playwright-report/
.claude/launch.json
artifacts/
.tmp-dbg/
.lhserver.log

.next-admin-test/

.lighthouseci/

scratch/

*.docx

# Design-skill local state and binaries (reinstalled by `npx impeccable install`)
.impeccable/config.local.json
.hallmark/
.claude/skills/impeccable/scripts/bin/

# Legacy file-based submission counter (submissions live in Supabase)
data/submission-counter.json

